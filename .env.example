# ==============================================================================
# Ferrovia Circumetnea (FCE) Bot - Environment Configuration
# ==============================================================================

# Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel ID or @public_handle for broadcasting service announcements (Optional)
# e.g., @circumetnea_avvisi or -1001234567890
TELEGRAM_CHANNEL_ID=

# Admin Telegram User IDs (comma-separated, get your ID with /chat_id command in the bot)
ADMIN_USER_IDS=

# ==============================================================================
# AI Travel Assistant Configuration (Google Gemini)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ==============================================================================
# Vercel & Webhook Deployment (Optional - for Vercel serverless deployment)
# ==============================================================================
# WEBHOOK_URL=https://your-project.vercel.app/api/webhook
# WEBHOOK_SECRET=your_random_secret_token_here
# CRON_SECRET=your_cron_secret_token_here
